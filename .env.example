# Copy this file to .env and fill it in. Never share .env with anyone.

# ── Telegram ─────────────────────────────────────────────────────────────────
# From @BotFather in Telegram (send /newbot)
TELEGRAM_BOT_TOKEN=

# Your own Telegram user ID. Start Vision, send /whoami to the bot, paste the number here, restart.
OWNER_ID=

# ── AI brains ─────────────────────────────────────────────────────────────────
# Primary (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=   # leave empty → auto-picks newest Flash

# Primary quality brain — Groq (groq.com) with 3-key rotation
# Free keys at: https://console.groq.com (sign up, create API key)
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_MODEL=llama-3.3-70b-versatile   # or llama-3.1-8b-instant for faster/cheaper

# Optional offline fallback (see docker-compose.yml)
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# ── Instagram ─────────────────────────────────────────────────────────────────
# See app/instagram.py for the 5-step one-time setup
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# ── Browser automation ────────────────────────────────────────────────────────
# Sessions are saved to data/sessions/ — run save_session.py once per site
BROWSER_HEADLESS=false   # set to true once you trust the automation

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8080

# ── Alerts ───────────────────────────────────────────────────────────────────
# Optional: make your phone RING when an agent is stuck (free CallMeBot service)
# 1) Set a Telegram username  2) Message @CallMeBot_txtbot and send /start
CALLMEBOT_USER=
NAG_MINUTES=10

TZ=Asia/Kolkata
